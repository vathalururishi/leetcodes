class Solution:
    def myAtoi(self, s: str) -> int:
        s = s.lstrip()

        sign = 1

        if s.startswith('-'):
            sign = -1
            s = s[1:]
        elif s.startswith('+'):
            s = s[1:]

        num = 0

        for ch in s:
            if not ch.isdigit():
                break
            num = num * 10 + int(ch)

        num *= sign

        return max(-2**31, min(num, 2**31 - 1))

        
